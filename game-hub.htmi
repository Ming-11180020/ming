<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>主宰游戏 - 暗黑红黑竖屏</title>
    <style>
        /* 基础重置 */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            -webkit-tap-highlight-color: transparent;
        }

        body {
            background-color: #0a0505; /* 极暗的红黑色底 */
            color: #e0e0e0;
            font-family: "PingFang SC", "Microsoft YaHei", sans-serif;
            display: flex;
            justify-content: center;
            height: 100vh;
            overflow: hidden;
            background-image: radial-gradient(circle at 50% 50%, #1a0a0a 0%, #050202 100%);
        }

        /* 模拟手机竖屏容器 */
        .mobile-container {
            width: 100%;
            max-width: 450px; /* 限制最大宽度，适配竖屏 */
            height: 100%;
            position: relative;
            display: flex;
            flex-direction: column;
            padding: 20px;
            overflow-y: auto;
        }

        /* ================= 顶部导航栏 ================= */
        .top-nav {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding-top: 20px;
            padding-bottom: 30px;
        }

        /* 本地模式胶囊按钮 */
        .local-mode-btn {
            display: flex;
            align-items: center;
            gap: 6px;
            padding: 6px 16px;
            border: 1px solid #d9534f;
            border-radius: 20px;
            color: #d9534f;
            font-size: 13px;
            background: rgba(217, 83, 79, 0.05);
            cursor: pointer;
            letter-spacing: 1px;
        }

        .local-mode-btn .icon-warning {
            font-size: 14px;
        }

        /* 音频/媒体占位按钮 */
        .audio-btn {
            width: 44px;
            height: 44px;
            border: 1px solid #d9534f;
            border-radius: 50%;
            display: flex;
            justify-content: center;
            align-items: center;
            color: #d9534f;
            font-size: 20px;
            background: rgba(217, 83, 79, 0.05);
            cursor: pointer;
            transition: all 0.3s;
        }

        .audio-btn:active {
            background: rgba(217, 83, 79, 0.2);
        }

        /* 音频留空区 - 用于放置隐藏的 audio 标签 */
        .audio-wrapper {
            position: absolute;
            top: 20px;
            right: 20px;
            width: 44px;
            height: 44px;
            opacity: 0;
            pointer-events: none; /* 隐藏原生播放器，通过按钮控制 */
        }

        /* ================= 核心内容区 ================= */
        .main-content {
            flex: 1;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            text-align: center;
            padding-bottom: 80px;
            position: relative;
        }

        /* 标题 */
        .main-title {
            font-size: 48px;
            font-weight: 900;
            color: #d9534f;
            letter-spacing: 8px;
            margin-bottom: 25px;
            text-shadow: 0 0 10px rgba(217, 83, 79, 0.4), 0 0 20px rgba(217, 83, 79, 0.2);
            position: relative;
        }

        /* 装饰性小圆点 (纯CSS模拟图中的灰尘颗粒) */
        .main-title::before, .main-title::after {
            content: '';
            position: absolute;
            width: 4px;
            height: 4px;
            background-color: #d9534f;
            border-radius: 50%;
            opacity: 0.5;
        }
        .main-title::before { top: -10px; left: -20px; }
        .main-title::after { bottom: -10px; right: -20px; width: 3px; height: 3px; }

        /* 副标题和标签 */
        .subtitle {
            font-size: 16px;
            color: #a0a0a0;
            letter-spacing: 2px;
            margin-bottom: 15px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .subtitle .dot {
            width: 4px;
            height: 4px;
            background-color: #a0a0a0;
            border-radius: 50%;
        }

        /* 剧情标签栏 */
        .tags-line {
            font-size: 14px;
            color: #888;
            letter-spacing: 1px;
            margin-bottom: 60px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }

        .tags-line .arrow {
            color: #d9534f;
            font-size: 12px;
        }

        /* ================= 底部按钮区 ================= */
        .button-group {
            width: 100%;
            display: flex;
            flex-direction: column;
            gap: 20px;
            margin-top: auto;
            padding-bottom: 40px;
        }

        /* 主按钮 - 开始游戏 */
        .btn-primary {
            width: 100%;
            padding: 18px 0;
            background: linear-gradient(135deg, #a63631 0%, #d9534f 100%);
            border: none;
            border-radius: 8px;
            color: #fff;
            font-size: 18px;
            font-weight: bold;
            letter-spacing: 2px;
            cursor: pointer;
            box-shadow: 0 4px 15px rgba(217, 83, 79, 0.3);
            transition: transform 0.1s, box-shadow 0.2s;
        }

        .btn-primary:active {
            transform: scale(0.98);
            box-shadow: 0 2px 8px rgba(217, 83, 79, 0.4);
        }

        /* 次要按钮 - 读取存档 */
        .btn-secondary {
            width: 100%;
            padding: 18px 0;
            background: transparent;
            border: 1px solid #4a3a3a; /* 暗红色边框 */
            border-radius: 8px;
            color: #ccc;
            font-size: 18px;
            letter-spacing: 2px;
            cursor: pointer;
            transition: all 0.3s;
        }

        .btn-secondary:active {
            background: rgba(217, 83, 79, 0.1);
            border-color: #d9534f;
            color: #d9534f;
        }

        /* ================= 背景装饰 ================= */
        /* 营造暗黑恐怖氛围的噪点或暗角 */
        .vignette {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            background: radial-gradient(circle, transparent 40%, rgba(0,0,0,0.8) 100%);
            z-index: -1;
        }
    </style>
</head>
<body>

    <div class="vignette"></div>

    <div class="mobile-container">
        
        <!-- ================= 顶部导航区 ================= -->
        <header class="top-nav">
            <div class="local-mode-btn">
                <span class="icon-warning">⚠</span>
                <span>本地模式</span>
            </div>
            
            <!-- 音频按钮 (点击可控制留空的音频) -->
            <div class="audio-btn" id="audioToggle">
                🎵
            </div>
            
            <!-- 音频留空区：这里放入你的 audio 标签，src 留空 -->
            <div class="audio-wrapper">
                <audio id="bgm" loop>
                    <!-- <source src="你的音频文件.mp3" type="audio/mpeg"> -->
                </audio>
            </div>
        </header>

        <!-- ================= 核心内容区 ================= -->
        <main class="main-content">
            
            <!-- 主标题 -->
            <h1 class="main-title">主宰游戏</h1>
            
            <!-- 副标题标签 (留空让你自己填写) -->
            <div class="subtitle">
                <span>无限流</span>
                <span class="dot"></span>
                <span>副本直播</span>
                <span class="dot"></span>
                <span>恐怖悬疑</span>
            </div>
            
            <!-- 剧情关卡文字 (留空让你自己填写) -->
            <div class="tags-line">
                <span>虚妄酒店</span>
                <span class="arrow">→</span>
                <span>副本火车</span>
                <span class="arrow">→</span>
                <span>暗黑高校</span>
                <span class="arrow">→</span>
                <span>诡市</span>
            </div>

            <!-- 按钮组 -->
            <div class="button-group">
                <button class="btn-primary" onclick="startGame()">开始游戏</button>
                <button class="btn-secondary" onclick="loadGame()">读取存档</button>
            </div>

        </main>
    </div>

    <!-- 交互逻辑脚本 -->
    <script>
        // 音频控制逻辑
        const audioBtn = document.getElementById('audioToggle');
        const bgm = document.getElementById('bgm');
        let isPlaying = false;

        audioBtn.addEventListener('click', () => {
            // 如果你在 audio 标签里填了 src，可以取消下面的注释来测试播放
            /*
            if (!isPlaying) {
                bgm.play().then(() => {
                    isPlaying = true;
                    audioBtn.style.color = '#fff';
                    audioBtn.style.borderColor = '#fff';
                }).catch(e => console.log('需要用户交互才能播放音频'));
            } else {
                bgm.pause();
                isPlaying = false;
                audioBtn.style.color = '#d9534f';
                audioBtn.style.borderColor = '#d9534f';
            }
            */
            console.log('音频按钮已点击，请在 audio 标签中填入 src 并开启 JS 注释');
        });

        // 按钮点击逻辑
        function startGame() {
            console.log('开始游戏...');
            // 在这里写跳转逻辑，例如 window.location.href = 'game.html';
        }

        function loadGame() {
            console.log('读取存档...');
            // 在这里写读取存档逻辑
        }
    </script>
</body>
</html>
